{
  "id": "camp-branches-v1",
  "name": "Camp afternoon planning",
  "start": "welcome",
  "steps": [
    {
      "id": "welcome",
      "type": "information",
      "title": "Plan a fictional camp afternoon",
      "body": "Choose sample activities for a fictional afternoon outdoors. This is a demonstration, not a booking service.",
      "next": "pace"
    },
    {
      "id": "pace",
      "type": "single-select",
      "title": "Choose your pace",
      "options": [
        {
          "id": "gentle",
          "label": "Gentle stroll"
        },
        {
          "id": "active",
          "label": "Active hike"
        }
      ],
      "next": "interests"
    },
    {
      "id": "interests",
      "type": "multi-select",
      "title": "Choose camp activities",
      "body": "Choose one or two interests.",
      "options": [
        {
          "id": "forest",
          "label": "Forest walk"
        },
        {
          "id": "water",
          "label": "Lakeside picnic"
        },
        {
          "id": "view",
          "label": "Hilltop views"
        }
      ],
      "min": 1,
      "max": 2,
      "transition": {
        "default": "hours",
        "branches": [
          {
            "next": "waterside",
            "when": {
              "operator": "includes",
              "stepId": "interests",
              "value": "water"
            }
          }
        ]
      }
    },
    {
      "id": "waterside",
      "type": "information",
      "title": "Your sample lakeside stop",
      "body": "The fictional plan includes a designated picnic area beside the lake.",
      "next": "hours"
    },
    {
      "id": "hours",
      "type": "number",
      "title": "How many hours do you have?",
      "body": "Enter a number from 1 to 8.",
      "min": 1,
      "max": 8,
      "next": "prepare"
    },
    {
      "id": "prepare",
      "type": "information",
      "title": "Before you head out",
      "body": "Bring water, check the weather, and tell someone your route. These are fictional suggestions.",
      "next": "result"
    },
    {
      "id": "result",
      "type": "result",
      "title": "Your sample camp afternoon is ready",
      "body": "A short woodland walk and a picnic are the starting points for this fictional plan.",
      "cta": {
        "label": "Explore camp ideas",
        "href": "https://www.nps.gov/subjects/camping/index.htm"
      }
    }
  ],
  "variants": {
    "B": {
      "steps": {
        "welcome": {
          "title": "Build your sample camp afternoon"
        },
        "result": {
          "cta": {
            "label": "Find your sample camp",
            "href": "https://www.nps.gov/subjects/camping/index.htm"
          }
        }
      }
    }
  }
}
