{
  "id": "trail-iteration-two-v2",
  "name": "Trail planning, second iteration",
  "start": "welcome",
  "steps": [
    {
      "id": "welcome",
      "type": "information",
      "title": "Plan a fictional weekend trail",
      "body": "Answer a few questions to discover a sample trail plan. This is a demonstration, not a booking service.",
      "next": "pace"
    },
    {
      "id": "pace",
      "type": "single-select",
      "title": "Choose your pace",
      "options": [
        {
          "id": "gentle",
          "label": "Gentle stroll"
        },
        {
          "id": "active",
          "label": "Active hike"
        }
      ],
      "transition": {
        "default": "interests",
        "branches": [
          {
            "next": "supplies",
            "when": {
              "operator": "equals",
              "stepId": "pace",
              "value": "active"
            }
          }
        ]
      }
    },
    {
      "id": "supplies",
      "type": "single-select",
      "title": "Choose your trail supplies",
      "body": "The active trail includes a fictional equipment check.",
      "options": [
        {
          "id": "shoes",
          "label": "Walking shoes"
        },
        {
          "id": "boots",
          "label": "Hiking boots"
        }
      ],
      "next": "interests"
    },
    {
      "id": "interests",
      "type": "multi-select",
      "title": "What would you like to see?",
      "body": "Choose one or two interests.",
      "options": [
        {
          "id": "forest",
          "label": "Forest"
        },
        {
          "id": "water",
          "label": "Waterfalls"
        },
        {
          "id": "view",
          "label": "Mountain views"
        }
      ],
      "min": 1,
      "max": 2,
      "next": "hours"
    },
    {
      "id": "hours",
      "type": "number",
      "title": "How many hours do you have?",
      "body": "Enter a number from 1 to 8.",
      "min": 1,
      "max": 8,
      "transition": {
        "default": "prepare",
        "branches": [
          {
            "next": "rest",
            "when": {
              "operator": "gte",
              "stepId": "hours",
              "value": 4
            }
          }
        ]
      }
    },
    {
      "id": "rest",
      "type": "information",
      "title": "Plan a fictional rest stop",
      "body": "Longer sample outings include a pause to rest and enjoy the surroundings. This is a fictional planning suggestion.",
      "next": "prepare"
    },
    {
      "id": "prepare",
      "type": "information",
      "title": "Before you head out",
      "body": "Bring water, check the weather, and tell someone your route. These are fictional suggestions.",
      "next": "result"
    },
    {
      "id": "result",
      "type": "result",
      "title": "Your sample trail plan is ready",
      "body": "A nearby woodland loop is a good starting point for your fictional weekend.",
      "cta": {
        "label": "Explore trail ideas",
        "href": "https://www.nps.gov/subjects/trails/index.htm"
      }
    }
  ],
  "variants": {
    "B": {
      "steps": {
        "welcome": {
          "title": "Build your weekend trail plan",
          "next": "hours"
        },
        "hours": {
          "transition": {
            "default": "pace",
            "branches": [
              {
                "next": "rest",
                "when": {
                  "operator": "gte",
                  "stepId": "hours",
                  "value": 4
                }
              }
            ]
          }
        },
        "interests": {
          "next": "result"
        },
        "result": {
          "cta": {
            "label": "Find your next trail",
            "href": "https://www.nps.gov/subjects/trails/index.htm"
          },
          "title": "Your next trail starts here"
        },
        "rest": {
          "next": "pace"
        }
      },
      "removeSteps": ["prepare"]
    }
  },
  "eventTypes": [
    {
      "type": "information_acknowledged",
      "on": "step_completed",
      "stepIds": ["rest"],
      "properties": {
        "acknowledged": {
          "kind": "boolean",
          "emit": true
        },
        "screen": {
          "kind": "step",
          "emit": "source"
        }
      }
    }
  ]
}
