{
  "name": "@core/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./worker": {
      "types": "./src/worker.ts",
      "import": "./src/worker.ts"
    },
    "./routes": {
      "types": "./src/routes.ts",
      "import": "./src/routes.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:integration": "cd ../.. && vitest run --config vitest.stack.config.ts apps/backend/test/*.integration.test.ts"
  },
  "dependencies": {
    "@core/capability": "workspace:*",
    "@core/core": "workspace:*",
    "@core/database": "workspace:*",
    "alchemy": "2.0.0-beta.80",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
