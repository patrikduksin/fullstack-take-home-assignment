{
  "name": "@core/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "import": "./src/contracts.ts"
    },
    "./funnel/*": {
      "types": "./src/funnel/*.ts",
      "import": "./src/funnel/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@core/capability": "workspace:*",
    "@xstate/effect": "0.1.0-alpha.6",
    "effect": "4.0.0",
    "xstate": "6.0.0-alpha.63"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  }
}
