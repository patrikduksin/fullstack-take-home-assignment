      "default": "./dist/call-watch.js"
    },
    "./approval": {
      "types": "./src/approval.ts",
      "import": "./src/approval.ts",
      "default": "./dist/approval.js"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "import": "./src/contract.ts",
      "default": "./dist/contract.js"
    },
    "./define": {
      "types": "./src/define.ts",
      "import": "./src/define.ts",
      "default": "./dist/define.js"
